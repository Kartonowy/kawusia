<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@color/beige"
        >
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/brown"
            android:text="Gra w kosci. Autor 0000000000"
            android:textColor="@color/white"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:textSize="20sp"
            />
        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RZUC KOSCMI"
            android:backgroundTint="@color/Chocolate"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:id="@+id/throwdice"
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal"
            android:background="@color/white"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            >
            <ImageView
                android:id="@+id/dice1"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_margin="9dp"
                android:src="@drawable/k1"
                />
            <ImageView
                android:id="@+id/dice2"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_margin="9dp"
                android:src="@drawable/k2"
                />
            <ImageView
                android:id="@+id/dice3"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_margin="9dp"
                android:src="@drawable/k3"
                />
            <ImageView
                android:id="@+id/dice4"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_margin="9dp"
                android:src="@drawable/k4"
                />
            <ImageView
                android:id="@+id/dice5"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_margin="9dp"
                android:src="@drawable/k5"
                />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:text="Wynik tego losowania: "
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:id="@+id/rollresult"
            />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:text="Wynik gry: "
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:id="@+id/gameresult"
            />

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/Chocolate"
            android:text="RESETUJ WYNIK"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:id="@+id/reset"
            />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>